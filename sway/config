set $mod Mod4
set $left h
set $down j
set $up k
set $right l
xwayland force

output eDP-1 scale 1
output "*" bg /home/ed/pics/dreamy_nostalgic_720p.png fill

exec_always test -f ~/.Xresources && xrdb -merge ~/.Xresources
exec mkdir -p /run/user/1000/pulse && ln -sf /run/pipewire/pulse/native /run/user/1000/pulse/native
exec foot --server
set $term footclient -e tmux
exec_always autotiling

exec mako
exec blueman-applet
exec CopyQ
exec wl-paste --watch cliphist store
exec_always dbus-update-activation-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP QT_QPA_PLATFORM
exec_always while :; do ~/.local/bin/battery-notify.sh; sleep 30; done
exec_always /home/i/gemini_daemon/run.sh
set $menu combined-menu

bindsym $mod+Return exec bash -ic f
bindsym $mod+Shift+Return exec foot -e ~/.local/bin/depth-launch
bindsym $mod+Shift+x kill
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu

bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# Moved from $mod+Shift+z, then from $mod+Shift+d (now used for always-on Gemini video)
bindsym $mod+Shift+t exec ~/.config/sway/toggle-display.sh
bindsym $mod+Shift+a exec flameshot gui
bindsym $mod+Shift+v exec cliphist list | wmenu | cliphist decode | wl-copy
bindsym $mod+Shift+r exec sh -c 'sway-mirror --stop 2>/dev/null; pkill -USR2 waybar 2>/dev/null'

# Gemini Live push-to-talk: hold Mod4+z to talk, release to send/respond
bindsym --no-repeat $mod+z exec /usr/bin/node /home/i/gemini_daemon/client.mjs down
bindsym --release $mod+z exec /usr/bin/node /home/i/gemini_daemon/client.mjs up

# Gemini Live screenshot+talk: hold Mod4+a — captures a screenshot + your voice, release to send
bindsym --no-repeat $mod+a exec /home/i/gemini_daemon/mod-a.sh
bindsym --release $mod+a exec /usr/bin/node /home/i/gemini_daemon/client.mjs up

# Gemini Live screen recording+talk: hold Mod4+q — records screen + your voice, release to send
bindsym --no-repeat $mod+q exec /home/i/gemini_daemon/mod-q.sh
bindsym --release $mod+q exec /usr/bin/node /home/i/gemini_daemon/client.mjs up

# Gemini Live always-on audio: press Mod4+Shift+z to toggle conversation mode (like i/18 static)
# Just talk — Gemini responds when you stop. Press again for push-to-talk.
bindsym $mod+Shift+z exec /home/i/gemini_daemon/always-on-audio.sh

# Gemini Live always-on video: press Mod4+Shift+d to toggle conversation mode with screen recording
bindsym $mod+Shift+d exec /home/i/gemini_daemon/always-on-video.sh

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
# NOTE: $mod+a was 'focus parent' but is now Gemini screenshot+talk


bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

floating_modifier $mod normal

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop
bindsym --locked XF86MonBrightnessDown exec light -U 5
bindsym --locked XF86MonBrightnessUp exec light -A 5

# Volume / brightness hotkeys (for keyboards without media keys)
bindsym $mod+Control+Down exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+Control+Up exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym $mod+Control+m exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym $mod+Control+Left exec light -U 5
bindsym $mod+Control+Right exec light -A 5
bindsym Print exec flameshot gui
bindsym $mod+Print exec flameshot full
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | wl-copy

# Screenshot current screen straight to clipboard
bindsym $mod+Control+a exec grim - | wl-copy

# Clipboard history multi-paste: Mod+Ctrl+N copies last N items (chronological order) to clipboard
# Mod+Ctrl+Shift+N copies last N items (reverse/newest-first) to clipboard
bindsym $mod+Control+1 exec ~/.config/sway/clip-multi.sh 1 normal
bindsym $mod+Control+2 exec ~/.config/sway/clip-multi.sh 2 normal
bindsym $mod+Control+3 exec ~/.config/sway/clip-multi.sh 3 normal
bindsym $mod+Control+4 exec ~/.config/sway/clip-multi.sh 4 normal
bindsym $mod+Control+5 exec ~/.config/sway/clip-multi.sh 5 normal
bindsym $mod+Control+6 exec ~/.config/sway/clip-multi.sh 6 normal
bindsym $mod+Control+7 exec ~/.config/sway/clip-multi.sh 7 normal
bindsym $mod+Control+8 exec ~/.config/sway/clip-multi.sh 8 normal
bindsym $mod+Control+9 exec ~/.config/sway/clip-multi.sh 9 normal
bindsym $mod+Control+0 exec ~/.config/sway/clip-multi.sh 10 normal
bindsym $mod+Control+Shift+1 exec ~/.config/sway/clip-multi.sh 1 reverse
bindsym $mod+Control+Shift+2 exec ~/.config/sway/clip-multi.sh 2 reverse
bindsym $mod+Control+Shift+3 exec ~/.config/sway/clip-multi.sh 3 reverse
bindsym $mod+Control+Shift+4 exec ~/.config/sway/clip-multi.sh 4 reverse
bindsym $mod+Control+Shift+5 exec ~/.config/sway/clip-multi.sh 5 reverse
bindsym $mod+Control+Shift+6 exec ~/.config/sway/clip-multi.sh 6 reverse
bindsym $mod+Control+Shift+7 exec ~/.config/sway/clip-multi.sh 7 reverse
bindsym $mod+Control+Shift+8 exec ~/.config/sway/clip-multi.sh 8 reverse
bindsym $mod+Control+Shift+9 exec ~/.config/sway/clip-multi.sh 9 reverse
bindsym $mod+Control+Shift+0 exec ~/.config/sway/clip-multi.sh 10 reverse

# Global voice: Mod+Ctrl+R — same engine as pi's Ctrl+R (local whisper.cpp on 8081)
# Toggle: press to start recording, press again to stop → transcribe → wl-copy + Ctrl+V paste
bindsym $mod+Control+r exec ~/.local/bin/sway-voice-global.sh

bar {
    swaybar_command waybar
}

for_window [window_role="pop-up"] floating enable
for_window [window_role="Pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="notification"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="popup_menu"] floating enable
for_window [window_type="dropdown_menu"] floating enable
for_window [title="^Picture-in-Picture$"] floating enable, sticky enable, move position center
for_window [title="^Picture in picture$"] floating enable, sticky enable, move position center
# Chrome's Document Picture-in-Picture windows (WhatsApp call mini-player, Spotify web mini-player, etc)
# share app_id=google-chrome with every other Chrome window and carry no PiP hint, only a title
# that lacks the usual "... - Google Chrome" suffix real tabs/windows always have.
for_window [app_id="google-chrome" title="^(?!.*Google Chrome).*$"] floating enable, sticky enable, move position center, resize set 400 300
exec_always python3 ~/.config/sway/pip-remember.py
for_window [app_id="google-chrome" title="^.* — Google Chrome$"] floating enable, resize set 800 600
for_window [app_id="chromium" title="^.*new request|popup|auth"] floating enable, resize set 800 600
for_window [app_id="firefox" title="^Extension:"] floating enable
for_window [app_id="firefox" title="^.*Mozilla Firefox$"] floating enable

input "1739:52599:SYNA308F:00_06CB:CD77_Touchpad" {
    tap enabled
}

include /etc/sway/config.d/*
