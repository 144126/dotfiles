Host pilotspan-dev-workspace
    HostName 192.168.122.80
    User ghogan
    PubkeyAuthentication yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519_pilotspan
    AddKeysToAgent yes
    GSSAPIAuthentication no
    Compression no
    IPQoS lowdelay throughput
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 1h
    AddressFamily inet
    CanonicalizeHostname no
    SetEnv TERM=xterm-256color
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    # RemoteForward on-demand: ssh -O forward -R 127.0.0.1:18082:127.0.0.1:8082 pilotspan-dev-workspace
    RemoteForward 127.0.0.1:18082 127.0.0.1:8082
