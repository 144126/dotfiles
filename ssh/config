Host pilotspan-dev-workspace
    HostName 192.168.122.80
    User ghogan
    PubkeyAuthentication yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519_pilotspan
    AddKeysToAgent yes
    GSSAPIAuthentication no
    Compression no
    IPQoS af21 cs1
    TCPKeepAlive yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 1h
    AddressFamily inet
    CanonicalizeHostname no
    SetEnv TERM=xterm-256color
    LocalForward 3010 localhost:3010
    LocalForward 3690 localhost:3690
    LocalForward 3000 localhost:3000
    LocalForward 3001 localhost:3001
    LocalForward 3002 localhost:3002
    LocalForward 3003 localhost:3003
    # mic + whisper channels back to this laptop (used by remote pi Ctrl+R)
    RemoteForward 127.0.0.1:18082 127.0.0.1:8082
    RemoteForward 127.0.0.1:18083 127.0.0.1:8082
