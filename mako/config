font=monospace 11
default-timeout=5000
anchor=top-right
border-size=2
border-color=#89b4fa
background-color=#1e1e2e
text-color=#cdd6f4
width=400
height=200
padding=12
margin=15
border-radius=8
icons=1
max-icon-size=32
[urgency=low]
border-color=#a6e3a1
default-timeout=5000
[urgency=normal]
border-color=#89b4fa
default-timeout=10000
[urgency=high]
border-color=#f38ba8
default-timeout=0

# Left-click a notification -> focus the window (and switch to its workspace)
# that the notification came from. mako only passes $id to exec, so export it
# for the script and resolve the app via makoctl list -j.
on-button-left=exec export id; /home/ed/.local/bin/mako-focus-notification.sh
