#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["onnx-asr[cpu]==0.12.0", "numpy", "sounddevice"]
# ///
# Mod+q: press to talk, press again to stop. Each phrase is typed into the focused window once, when you pause.
# No live words and no corrections afterwards. Same local model as Mod+Ctrl+E (voice/stt.py).
# `voice-stream status` feeds waybar.
import fcntl, json, os, queue, signal, subprocess, sys, threading
from pathlib import Path

run = Path(os.environ['XDG_RUNTIME_DIR'])
lock = open(run / 'voice-stream.lock', 'a+')
state = run / 'voice-stream.state'
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    # already running: status reports it, anything else stops it
    if sys.argv[1:] == ['status']:
        print(json.dumps({'text': state.read_text() if state.exists() else '● voice'}))
    else:
        lock.seek(0)
        try:
            os.kill(int(lock.read()), signal.SIGUSR1)
        except (ValueError, ProcessLookupError):
            pass
    raise SystemExit
if sys.argv[1:] == ['status']:
    raise SystemExit(print('{"text":""}'))
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()
stop = threading.Event()
signal.signal(signal.SIGUSR1, lambda *_: stop.set())
signal.signal(signal.SIGTERM, lambda *_: stop.set())
notify = lambda t: subprocess.run(['notify-send', '-a', 'voice', '-t', '3000', 'voice', t], check=False)

FRAME = 320  # 20 ms at 16 kHz
PAUSE = 25  # 500 ms of quiet ends a phrase
MAX = 1000  # 20 s at most per phrase
try:
    state.write_text('● voice loading')
    import numpy as np, sounddevice as sd
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'voice'))
    from stt import load
    transcribe = load()
    q = queue.Queue()
    floor, pre, seg, loud_run, quiet = 0.005, [], None, 0, 0

    def say(frames):
        text = transcribe(np.concatenate(frames))
        # wtype puts its first key on keycode 9 (Escape); Electron drops a space there, so Shift_L takes it
        if text:
            subprocess.run(['wtype', '-k', 'Shift_L', '--', text + ' '], check=False)

    with sd.InputStream(samplerate=16000, channels=1, dtype='int16', blocksize=FRAME, callback=lambda d, *_: q.put(d[:, 0].copy())):
        state.write_text('● voice listening')
        while not stop.is_set():
            try:
                f = q.get(timeout=0.2)
            except queue.Empty:
                continue
            # energy gate: speech starts after two loud frames (with 200 ms pre-roll); the floor follows the quiet room
            level = np.sqrt(np.mean((f / 32768.0) ** 2))
            loud = level > max(0.01, floor * 4)
            if seg is None:
                if not loud:
                    floor = max(0.002, floor * 0.95 + level * 0.05)
                pre = (pre + [f])[-10:]
                loud_run = loud_run + 1 if loud else 0
                if loud_run >= 2:
                    seg, quiet = pre, 0
                continue
            seg.append(f)
            quiet = 0 if loud else quiet + 1
            if quiet >= PAUSE or len(seg) >= MAX:
                say(seg[: len(seg) - max(0, quiet - 10)])
                seg, pre, loud_run = None, [], 0
    if seg:
        say(seg)
    notify('voice stopped')
except Exception as error:
    notify('voice error: ' + str(error))
finally:
    state.unlink(missing_ok=True)
