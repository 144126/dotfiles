#!/home/ed/.local/share/pipx/venvs/moonshine-voice/bin/python
import fcntl
import json
import os
import signal
import subprocess
import threading
import time
from pathlib import Path

os.environ.pop('LD_LIBRARY_PATH', None)

lock = open(Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.lock', 'a+')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    lock.seek(0)
    try:
        time.sleep(0.4)
        os.kill(int(lock.read()), signal.SIGUSR1)
    except (ValueError, ProcessLookupError):
        pass
    raise SystemExit
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()
stop = threading.Event()
signal.signal(signal.SIGUSR1, lambda *_: stop.set())
signal.signal(signal.SIGTERM, lambda *_: stop.set())

def notify(text):
    subprocess.run(['notify-send', '-a', 'voice', '-t', '3000', 'voice', text], check=False)

def focused():
    tree = json.loads(subprocess.check_output(['swaymsg', '-t', 'get_tree']))
    def find(node):
        if node.get('focused'):
            return node['id']
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            found = find(child)
            if found is not None:
                return found
    return find(tree)

try:
    from moonshine_voice import MicTranscriber
    target = focused()
    if target is None:
        raise RuntimeError('no focused window')
    previous = ''
    written = ''
    def output(text, final=False):
        global previous, written
        if stop.is_set() and not final:
            return
        if focused() != target:
            notify('stopped: focus changed')
            stop.set()
            return
        if not text.startswith(written):
            notify('stopped: transcription changed; check the last words')
            stop.set()
            return
        if final:
            stable = text
        else:
            common = os.path.commonprefix([previous, text])
            stable = common[:common.rfind(' ') + 1]
        previous = text
        if len(stable) > len(written):
            subprocess.run(['wtype', '--', stable[len(written):]], check=True)
            written = stable
        if final:
            if written and not written.endswith(' '):
                subprocess.run(['wtype', '--', ' '], check=True)
            previous = written = ''
    mic = MicTranscriber().language('en').on_text(output).on_line(lambda line: output(line.text, True)).on_error(lambda error: (notify(str(error)), stop.set()))
    mic.load()
    if not stop.is_set() and focused() == target:
        time.sleep(0.4)
        mic.start()
        notify('listening · Mod+Ctrl+T to stop')
        while not stop.wait(0.2):
            if focused() != target:
                notify('stopped: focus changed')
                break
        mic.stop()
    mic.close()
    notify('stopped')
except Exception as error:
    notify('voice error: ' + str(error))
