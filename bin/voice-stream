#!/home/ed/.local/share/pipx/venvs/onnx-asr/bin/python
import fcntl
import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path


os.environ.pop('LD_LIBRARY_PATH', None)
lock = open(Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.lock', 'a+')
state = Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.state'
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    if sys.argv[1:] == ['status']:
        print(json.dumps({'text': state.read_text() if state.exists() else '● voice loading'}))
    else:
        lock.seek(0)
        try:
            time.sleep(0.4)
            os.kill(int(lock.read()), signal.SIGUSR1)
        except (ValueError, ProcessLookupError):
            pass
    raise SystemExit
if sys.argv[1:] == ['status']:
    print('{"text":""}')
    raise SystemExit
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()
stop = threading.Event()
signal.signal(signal.SIGUSR1, lambda *_: stop.set())
signal.signal(signal.SIGTERM, lambda *_: stop.set())

def notify(text):
    subprocess.run(['notify-send', '-a', 'voice', '-t', '4000', 'voice', text], check=False)

def focused():
    tree = json.loads(subprocess.check_output(['swaymsg', '-t', 'get_tree']))
    def find(node):
        if node.get('focused'):
            return node['id']
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            found = find(child)
            if found is not None:
                return found
    return find(tree)

state.write_text('● voice loading')
try:
    sys.path.insert(0, str(Path.home() / '.local/share/oido'))
    import ctypes, queue
    import numpy as np
    import sounddevice as sd
    import pytasr
    lib = pytasr._lib
    lib.tasr_seg_init.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    lib.tasr_seg_feed.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    lib.tasr_seg_feed.restype = ctypes.c_int
    lib.tasr_seg_next.argtypes = [ctypes.c_void_p]
    seg = ctypes.create_string_buffer(256)
    buf = np.zeros(16000 * 20, dtype=np.int16)
    lib.tasr_seg_init(seg, buf.ctypes.data, len(buf))
    seg[40:44] = (27).to_bytes(4, 'little')  # tasr_seg_t.hang in 20 ms blocks: 540 ms of silence ends a phrase
    target = focused()
    if target is None:
        raise RuntimeError('no focused window')
    clipboard = []
    def output(text):
        if not clipboard and focused() == target:
            # wtype puts its first key on keycode 9 (Escape); Electron drops a space there, so Shift_L takes it
            subprocess.run(['wtype', '-k', 'Shift_L', '--', text + ' '], check=True)
            return
        if not clipboard:
            state.write_text('● voice → clipboard')
            notify('window changed · remaining speech goes to clipboard')
        clipboard.append(text)
    # oido streams while you talk; at 540 ms of silence its text for the phrase is typed once
    # tasr_seg_t: int32 n at byte 20 (buffered samples), int32 speech at byte 24
    seg_n = lambda: int.from_bytes(seg.raw[20:24], 'little')
    in_speech = lambda: seg.raw[24:28] != bytes(4)
    models = Path.home() / 'models/oido'
    stream = pytasr.NemoStream(pytasr.Nemo(str(models / 'oido_v2a.tnm'), lm=pytasr.LM(str(models / 'oido_v2.tlm')), beam=4))
    stream.reset()
    def finish(n):
        stream.feed(buf[fed:n])
        if text := stream.finish():
            output(text)
        stream.reset()
    fed = 0
    q = queue.Queue()
    with sd.InputStream(samplerate=16000, channels=1, dtype='int16', blocksize=320, callback=lambda d, *_: q.put(d[:, 0].copy())):
        state.write_text('● voice listening')
        while not stop.is_set():
            try:
                block = q.get(timeout=0.2)
            except queue.Empty:
                continue
            if done := lib.tasr_seg_feed(seg, block.ctypes.data, len(block)):
                finish(done)
                fed = 0
                lib.tasr_seg_next(seg)
            elif not in_speech():
                if fed:
                    stream.reset()
                    fed = 0
            elif seg_n() > fed:
                stream.feed(buf[fed:seg_n()])
                fed = seg_n()
    state.write_text('● voice finishing')
    if in_speech():
        finish(seg_n())
    if clipboard:
        subprocess.run(['wl-copy'], input=' '.join(clipboard), text=True, check=True)
        notify('remaining speech copied')
    else:
        notify('voice stopped')
except Exception as error:
    notify('voice error: ' + str(error))
finally:
    state.unlink(missing_ok=True)
