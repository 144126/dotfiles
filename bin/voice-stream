#!/home/ed/.local/share/pipx/venvs/moonshine-voice/bin/python
import fcntl
import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

os.environ.pop('LD_LIBRARY_PATH', None)
lock = open(Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.lock', 'a+')
state = Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.state'
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    if sys.argv[1:] == ['status']:
        print(json.dumps({'text': state.read_text() if state.exists() else '● voice loading'}))
    else:
        lock.seek(0)
        try:
            time.sleep(0.4)
            os.kill(int(lock.read()), signal.SIGUSR1)
        except (ValueError, ProcessLookupError):
            pass
    raise SystemExit
if sys.argv[1:] == ['status']:
    print('{"text":""}')
    raise SystemExit
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()
stop = threading.Event()
signal.signal(signal.SIGUSR1, lambda *_: stop.set())
signal.signal(signal.SIGTERM, lambda *_: stop.set())

def notify(text):
    subprocess.run(['notify-send', '-a', 'voice', '-t', '4000', 'voice', text], check=False)

def focused():
    tree = json.loads(subprocess.check_output(['swaymsg', '-t', 'get_tree']))
    def find(node):
        if node.get('focused'):
            return node['id']
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            found = find(child)
            if found is not None:
                return found
    return find(tree)

state.write_text('● voice loading')
try:
    from moonshine_voice import MicTranscriber
    target = focused()
    if target is None:
        raise RuntimeError('no focused window')
    previous = ''
    written = ''
    clipboard = []
    diverted = False
    mutex = threading.RLock()
    def divert(reason):
        global diverted
        if not diverted:
            diverted = True
            state.write_text('● voice → clipboard')
            notify(reason + ' · remaining speech goes to clipboard')
    def output(text, final=False):
        global previous, written
        with mutex:
            if focused() != target:
                divert('window changed')
            if not diverted and not text.startswith(written):
                divert('earlier words changed; check the last phrase')
            if diverted:
                if final:
                    clipboard.append(text[len(written):] if text.startswith(written) else text)
                    previous = written = ''
                return
            if final:
                stable = text
            else:
                common = os.path.commonprefix([previous, text])
                stable = common[:common.rfind(' ') + 1]
            previous = text
            if len(stable) > len(written):
                subprocess.run(['wtype', '--', stable[len(written):]], check=True)
                written = stable
            if final:
                if written and not written.endswith(' '):
                    subprocess.run(['wtype', '--', ' '], check=True)
                previous = written = ''
    mic = MicTranscriber().language('en').on_text(output).on_line(lambda line: output(line.text, True)).on_error(lambda error: (notify(str(error)), stop.set()))
    mic.load()
    if not stop.is_set():
        if focused() != target:
            divert('window changed')
        time.sleep(0.4)
        mic.start()
        if not diverted:
            state.write_text('● voice listening')
        while not stop.wait(0.2):
            with mutex:
                if not diverted and focused() != target:
                    divert('window changed')
        state.write_text('● voice finishing')
        mic.stop()
    mic.close()
    if clipboard:
        subprocess.run(['wl-copy'], input=' '.join(x.strip() for x in clipboard if x.strip()), text=True, check=True)
        notify('remaining speech copied')
    else:
        notify('voice stopped')
except Exception as error:
    notify('voice error: ' + str(error))
finally:
    state.unlink(missing_ok=True)
