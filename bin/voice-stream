#!/home/ed/.local/share/pipx/venvs/moonshine-voice/bin/python
import fcntl
import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

import regex

os.environ.pop('LD_LIBRARY_PATH', None)
lock = open(Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.lock', 'a+')
state = Path(os.environ['XDG_RUNTIME_DIR']) / 'voice-stream.state'
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    if sys.argv[1:] == ['status']:
        print(json.dumps({'text': state.read_text() if state.exists() else '● voice loading'}))
    else:
        lock.seek(0)
        try:
            time.sleep(0.4)
            os.kill(int(lock.read()), signal.SIGUSR1)
        except (ValueError, ProcessLookupError):
            pass
    raise SystemExit
if sys.argv[1:] == ['status']:
    print('{"text":""}')
    raise SystemExit
lock.seek(0)
lock.truncate()
lock.write(str(os.getpid()))
lock.flush()
stop = threading.Event()
signal.signal(signal.SIGUSR1, lambda *_: stop.set())
signal.signal(signal.SIGTERM, lambda *_: stop.set())

def notify(text):
    subprocess.run(['notify-send', '-a', 'voice', '-t', '4000', 'voice', text], check=False)

def focused():
    tree = json.loads(subprocess.check_output(['swaymsg', '-t', 'get_tree']))
    def find(node):
        if node.get('focused'):
            return node['id']
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            found = find(child)
            if found is not None:
                return found
    return find(tree)

state.write_text('● voice loading')
try:
    sys.path.insert(0, str(Path.home() / '.local/share/oido'))
    import ctypes, queue
    import numpy as np
    import sounddevice as sd
    import pytasr
    models = Path.home() / 'models/oido'
    lib = pytasr._lib
    lib.tasr_seg_init.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    lib.tasr_seg_feed.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int]
    lib.tasr_seg_feed.restype = ctypes.c_int
    lib.tasr_seg_next.argtypes = [ctypes.c_void_p]
    eng = pytasr.Nemo(str(models / 'oido_v2a.tnm'), lm=pytasr.LM(str(models / 'oido_v2.tlm')), beam=4)
    stream = pytasr.NemoStream(eng)
    stream.reset()
    seg = ctypes.create_string_buffer(256)
    buf = np.zeros(16000 * 20, dtype=np.int16)
    lib.tasr_seg_init(seg, buf.ctypes.data, len(buf))
    target = focused()
    if target is None:
        raise RuntimeError('no focused window')
    # one wtype keeps one keymap: a fresh wtype puts its first char on keycode 9 (Escape) and Electron drops a space there
    kb = subprocess.Popen(['wtype', '-'], stdin=subprocess.PIPE, text=True)
    written = ''
    clipboard = []
    diverted = False
    def divert(reason):
        global diverted
        if not diverted:
            diverted = True
            state.write_text('● voice → clipboard')
            notify(reason + ' · remaining speech goes to clipboard')
    def output(text, final=False):
        global written
        if focused() != target:
            divert('window changed')
        if diverted:
            if final:
                if written and not text.startswith(written):
                    notify('clipboard contains the entire revised phrase; replace the last phrase')
                clipboard.append(text[len(written):] if text.startswith(written) else text)
                written = ''
            return
        old = regex.findall(r'\X', written)
        new = regex.findall(r'\X', text)
        common = 0
        while common < min(len(old), len(new)) and old[common] == new[common]:
            common += 1
        suffix = '\b' * (len(old) - common) + ''.join(new[common:])
        if final and text and not text.endswith(' '):
            suffix += ' '
        kb.stdin.write(suffix)
        kb.stdin.flush()
        written = '' if final else text
    # tasr_seg_t: int32 n at byte 20 (buffered samples), int32 speech at byte 24
    seg_n = lambda: int.from_bytes(seg.raw[20:24], 'little')
    in_speech = lambda: seg.raw[24:28] != bytes(4)
    def finish(n):
        stream.feed(buf[fed:n])
        output(stream.finish(), True)
        stream.reset()
    fed = 0
    hearing = False
    q = queue.Queue()
    with sd.InputStream(samplerate=16000, channels=1, dtype='int16', blocksize=320, callback=lambda d, *_: q.put(d[:, 0].copy())):
        state.write_text('● voice listening')
        while not stop.is_set():
            try:
                block = q.get(timeout=0.2)
            except queue.Empty:
                continue
            done = lib.tasr_seg_feed(seg, block.ctypes.data, len(block))
            if hearing and not in_speech() and not done:
                stream.reset()
                fed = 0
                output('')
            hearing = in_speech()
            if done:
                finish(done)
                fed = 0
                lib.tasr_seg_next(seg)
            elif hearing and seg_n() > fed:
                stream.feed(buf[fed:seg_n()])
                fed = seg_n()
                part = stream.partial()
                if part != written and not diverted:
                    output(part)
    state.write_text('● voice finishing')
    if hearing:
        finish(seg_n())
    kb.stdin.close()
    kb.wait()
    if clipboard:
        subprocess.run(['wl-copy'], input=''.join(x + (' ' if x and not x.endswith(' ') else '') for x in clipboard).rstrip(), text=True, check=True)
        notify('remaining speech copied')
    else:
        notify('voice stopped')
except Exception as error:
    notify('voice error: ' + str(error))
finally:
    state.unlink(missing_ok=True)
