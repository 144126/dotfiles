#!/bin/bash
# Combined launcher: desktop entries (scanned each run) + custom commands.
# Output is piped to wmenu; the selected line is executed.

TERM=${TERM:-urxvt}
CMDS="$HOME/.config/sway/commands.txt"

# Use a delimiter that cannot legitimately appear in a desktop Name= value
# (tab can, which previously corrupted the name<->file mapping).
SEP=$'\x1f'

# No cache file: a stale lookup cache hid newly installed apps.
list=$({
    # desktop entries
    grep -H -m1 '^Name=.' /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop 2>/dev/null |
        awk -v s="$SEP" '{ i = index($0, ":"); print substr($0, i + 6) s "@@DESKTOP@@" s substr($0, 1, i - 1) }'

    # custom commands
    if [ -f "$CMDS" ]; then
        while IFS= read -r line; do
            [ -z "$line" ] && continue
            case "$line" in \#*) continue ;; esac
            label=${line%%:*}
            cmd=${line#*:}
            if [ "$label" = "$cmd" ]; then
                printf '%s%s%s%s%s\n' "$line" "$SEP" "@@CMD@@" "$SEP" "$line"
            else
                printf '%s%s%s%s%s\n' "$label" "$SEP" "@@CMD@@" "$SEP" "$cmd"
            fi
        done < "$CMDS"
    fi
} | sort -u -t"$SEP" -k1,1)

sel=$(printf '%s\n' "$list" | cut -d"$SEP" -f1 | wmenu -i -l 12)
[ -n "$sel" ] || exit

# Match on the full first field, then split into exactly 3 fields on the SEP.
match=$(printf '%s\n' "$list" | awk -F"$SEP" -v s="$sel" '$1==s {print; exit}')
[ -n "$match" ] || exit

kind=$(printf '%s' "$match" | awk -F"$SEP" '{print $2}')
target=$(printf '%s' "$match" | awk -F"$SEP" '{print $3}')

case "$kind" in
    @@DESKTOP@@)
        exec=$(grep -m1 '^Exec=' "$target" 2>/dev/null | cut -d= -f2- | sed 's/ *%[fFuUdDnNickvm]//g')
        term=$(grep -m1 '^Terminal=' "$target" 2>/dev/null | cut -d= -f2)
        if [ "$term" = "true" ]; then
            setsid "$TERM" -e sh -c "$exec" >/dev/null 2>&1 &
        else
            setsid sh -c "$exec" >/dev/null 2>&1 &
        fi
        ;;
    @@CMD@@)
        setsid sh -c "$target" >/dev/null 2>&1 &
        ;;
esac
