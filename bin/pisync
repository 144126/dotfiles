#!/bin/bash
# mirrors local pi config to depth VM (pilotspan-dev-workspace over wg VPN)
set -e
H=pilotspan-dev-workspace
rsync -az --delete ~/.pi/agent/skills/     "$H:.pi/agent/skills/"
rsync -az --delete ~/.pi/agent/extensions/ "$H:.pi/agent/extensions/"
rsync -az ~/.pi/agent/AGENTS.md "$H:.pi/agent/AGENTS.md"
rsync -az ~/AGENTS.md "$H:AGENTS.md"
rsync -az ~/ed.md "$H:ed.md"
for f in models.json models-store.json settings.json keybindings.json; do
  [ -f ~/.pi/agent/$f ] && rsync -az ~/.pi/agent/$f "$H:.pi/agent/"
done
for f in auth.json trust.json; do
  [ -f ~/.pi/agent/$f ] && rsync --ignore-existing -az ~/.pi/agent/$f "$H:.pi/agent/"
done
echo synced.
