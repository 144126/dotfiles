#!/bin/bash
# say "text" — Leokani (local)
if [ "$1" = "--stop" ]; then /home/ed/.venvs/voice/bin/python /home/ed/i/144126/dotfiles/voice/voice.py --stop; pkill -f "pi-tts-" 2>/dev/null; pkill -x paplay 2>/dev/null; pkill -x ffplay 2>/dev/null; pkill -x mpv 2>/dev/null; exit 0; fi
force=0
if [ "$1" = "--force" ]; then force=1; shift; fi
[ "$force" = 0 ] && [ "$(cat /home/ed/.pi/speak 2>/dev/null)" = off ] && exit 0
text="${*:-$(cat)}"; [ -z "$text" ] && exit 0
wav="/tmp/pi-tts-$$.wav"
/home/ed/.venvs/voice/bin/python /home/ed/i/144126/dotfiles/voice/voice.py "$wav" <<< "$text" 2>/dev/null || exit 1
paplay "$wav" 2>/dev/null || ffplay -nodisp -autoexit -loglevel quiet "$wav" 2>/dev/null || aplay "$wav" 2>/dev/null
rm -f "$wav"
