#!/usr/bin/python3 -Bu
import ctypes
import fcntl
import os
from pathlib import Path
import struct
import subprocess
import sys
import syslog
import time


def main():
    target = Path(os.path.abspath(sys.argv[1])) if len(sys.argv) > 1 else Path.home() / "passwords.txt"
    lock = open(Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "password-canary.lock", "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    libc = ctypes.CDLL(None, use_errno=True)
    libc.inotify_init1.argtypes = [ctypes.c_int]
    libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    descriptor = libc.inotify_init1(os.O_CLOEXEC)
    if descriptor < 0:
        raise OSError(ctypes.get_errno(), "cannot start canary monitor")

    # Watching the parent keeps the watch valid when the bait is replaced.
    # Access, content/metadata changes, rename, creation, deletion, watch loss.
    if libc.inotify_add_watch(descriptor, os.fsencode(target.parent), 0xFC7) < 0:
        raise OSError(ctypes.get_errno(), "cannot watch canary directory")

    notification_id = "0"
    last_alert = float("-inf")

    def alert(message):
        nonlocal last_alert, notification_id
        print(message, flush=True)
        if time.monotonic() - last_alert < 5:
            return
        last_alert = time.monotonic()
        syslog.syslog(syslog.LOG_WARNING, f"password-canary: {message}: {target}")
        try:
            result = subprocess.run(
                ["/usr/bin/notify-send", "-a", "password-canary", "-u", "critical", "-t", "0",
                 "-p", "-r", notification_id, "password canary alert",
                 f"{message}\n{target}\nInvestigate the access. Networking remains on."],
                env={key: value for key, value in os.environ.items() if key != "LD_LIBRARY_PATH"},
                capture_output=True, text=True, timeout=5, check=True,
            )
            notification_id = result.stdout.strip()
            print(f"notification {notification_id}", flush=True)
        except (OSError, subprocess.SubprocessError) as error:
            syslog.syslog(syslog.LOG_ERR, f"password-canary notification failed: {error}")
            print(f"notification failed: {error}", file=sys.stderr, flush=True)

    print(f"watching {target}", flush=True)
    while True:
        events = os.read(descriptor, 65536)
        offset = 0
        while offset < len(events):
            _, mask, _, length = struct.unpack_from("iIII", events, offset)
            name = events[offset + 16:offset + 16 + length].rstrip(b"\0")
            offset += 16 + length
            if mask & 0x4000:
                alert("monitor overflow: file events were lost")
            elif mask & 0xAC00:
                alert("monitor stopped: canary directory is unavailable")
                raise RuntimeError("canary directory watch was lost")
            elif name == os.fsencode(target.name):
                alert("file read detected" if mask & 1 else "file changed, moved, or deleted")


if __name__ == "__main__":
    main()
