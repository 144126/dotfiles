#!/bin/bash
# xv <x-post-url> [out.mp4] — download the video from an X post via local cobalt. Prints file path.
set -e
url=$1
[ -n "$url" ] || { echo "usage: xv <x-post-url> [out.mp4]" >&2; exit 1; }
id=$(grep -oE 'status/[0-9]+' <<<"$url" | cut -d/ -f2)
exec cobalt "$url" "${2:-$HOME/Downloads/xv-${id:-$(date +%s)}.mp4}"
