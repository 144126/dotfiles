#!/usr/bin/python3
import json
import os
import re
import struct
import subprocess
import sys

SAY = "/home/ed/.local/bin/say"
BASHRC = os.path.expanduser("~/.bashrc")
DEFAULT_VOICE = "gb_jane_neutral"
DEFAULT_MODEL = "mistralai/voxtral-mini-tts-2603"
KEYS = ("OPENROUTER_API_KEY", "OPENROUTER_TTS_VOICE", "OPENROUTER_TTS_MODEL")


def read_msg():
    raw = sys.stdin.buffer.read(4)
    if not raw or len(raw) < 4:
        return None
    n = struct.unpack("<I", raw)[0]
    if n == 0:
        return {}
    return json.loads(sys.stdin.buffer.read(n).decode("utf-8"))


def write_msg(obj):
    data = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(data)))
    sys.stdout.buffer.write(data)
    sys.stdout.buffer.flush()


def bashrc_exports():
    out = {}
    try:
        text = open(BASHRC, encoding="utf-8").read()
    except OSError:
        return out
    for key in KEYS:
        m = re.search(
            rf"^\s*export {re.escape(key)}=([\"']?)(.*)\1\s*$",
            text,
            re.M,
        )
        if m:
            out[key] = m.group(2)
    return out


def env_for_say():
    env = os.environ.copy()
    bash = bashrc_exports()
    for key in KEYS:
        if not env.get(key) and bash.get(key):
            env[key] = bash[key]
    return env


def cfg():
    env = env_for_say()
    return {
        "ok": True,
        "voice": env.get("OPENROUTER_TTS_VOICE") or DEFAULT_VOICE,
        "model": env.get("OPENROUTER_TTS_MODEL") or DEFAULT_MODEL,
        "has_key": bool(env.get("OPENROUTER_API_KEY")),
    }


def speak(text):
    text = (text or "").strip()
    if not text:
        return {"ok": False, "error": "empty"}
    subprocess.Popen(
        [SAY, "--force", text],
        env=env_for_say(),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return {"ok": True}


def main():
    while True:
        msg = read_msg()
        if msg is None:
            return
        if msg.get("type") == "speak":
            write_msg(speak(msg.get("text") or ""))
        else:
            write_msg(cfg())


if __name__ == "__main__":
    main()
